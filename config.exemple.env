# =====================================================================
# RM Paie — configuration du serveur au Maroc
# Copiez ce fichier en « config.env », complétez-le, puis lancez : sudo sh installer.sh
# Ne transmettez jamais config.env : il contient des secrets.
# =====================================================================

# --- Nom de domaine (les 3 adresses doivent pointer vers l'IP du serveur : enregistrements DNS de type A)
#   DOMAINE          → le site et le logiciel           ex. rmpaie.ma
#   api.DOMAINE      → l'API (base de données, comptes, fonctions)
#   studio.DOMAINE   → la console d'administration technique (protégée par mot de passe)
DOMAINE=rmpaie.ma
EMAIL_ADMIN=contact@rmpaie.ma           # certificats HTTPS et alertes techniques

# --- Accès à la console technique (studio.DOMAINE) : adresses IP autorisées, séparées par des espaces.
# Laissez la valeur par défaut pour tout autoriser (le mot de passe reste exigé) ; mettez l'IP fixe du cabinet pour restreindre.
STUDIO_IP_AUTORISEES="0.0.0.0/0 ::/0"

# --- Envoi des e-mails (comptes, bulletins, rappels, alertes) par SMTP
# Utilisez la messagerie professionnelle de votre hébergeur au Maroc (ou tout fournisseur SMTP).
SMTP_HOST=smtp.votre-hebergeur.ma
SMTP_PORT=465                           # 465 (SSL) ou 587 (STARTTLS)
SMTP_SECURITE=ssl                       # ssl | starttls
SMTP_USER=no-reply@rmpaie.ma
SMTP_PASS=''                             # entre apostrophes si le mot de passe contient $ ou des espaces
SMTP_EXPEDITEUR_NOM="RM Paie"
SMTP_EXPEDITEUR=no-reply@rmpaie.ma

# --- Paiement par carte : identifiants fournis par votre acquéreur (laissez vides en attendant)
CMI_CLIENT_ID=
CMI_STORE_KEY=''
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate   # remplacer par l'adresse de production après la recette

# --- WhatsApp (facultatif) : envoi des bulletins par WhatsApp Business
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=bulletin_paie
WHATSAPP_TEMPLATE_LANG=fr

# --- Alertes : adresse qui reçoit les erreurs et les incidents du serveur
ALERTE_EMAIL=contact@rmpaie.ma

# --- Sauvegardes chiffrées
# Clé PUBLIQUE age (commence par « age1… »). Générez la paire sur VOTRE ordinateur : age-keygen -o rmpaie-sauvegarde.key
# Gardez la clé privée hors du serveur (clé USB au cabinet + coffre) : sans elle, les sauvegardes sont illisibles.
SAUVEGARDE_CLE_PUBLIQUE=
# Copie hors site, sur un second serveur AU MAROC (autre ville ou autre hébergeur), par SSH. Vide = copie locale seulement.
#   ex. sauvegarde@ip-du-second-serveur:/srv/sauvegardes/rmpaie
SAUVEGARDE_DESTINATION=
SAUVEGARDE_JOURS=14                     # durée de conservation sur ce serveur
SAUVEGARDE_JOURS_DISTANT=90             # durée de conservation sur le second serveur
