# RM Paie — serveur web (HTTPS automatique Let's Encrypt)
{
	email {$EMAIL_ADMIN}
}

# Le site et le logiciel (fichiers statiques)
{$DOMAINE}, www.{$DOMAINE} {
	@www host www.{$DOMAINE}
	redir @www https://{$DOMAINE}{uri} permanent

	root * /srv/site
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Robots-Tag "noai, noimageai"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		# Politique de contenu stricte : seuls nos propres scripts s'exécutent (aucun script en ligne, aucun domaine tiers).
		# blob: sert au moteur de paie chargé depuis le stockage privé ; les données ne partent que vers notre API.
		Content-Security-Policy "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.{$DOMAINE} wss://api.{$DOMAINE}; media-src 'self'; frame-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' {$ORIGINE_PAIEMENT}; frame-ancestors 'none'; upgrade-insecure-requests"
		-Server
	}
	@immuable path /vendor/* /fonts/*
	header @immuable Cache-Control "public, max-age=31536000, immutable"
	@noindex path /app.js /saas.js /config.js
	header @noindex X-Robots-Tag "noindex, noai"
	# Le moteur de paie n'est jamais servi comme fichier public (il est lu depuis le stockage privé après connexion)
	@prive path /prive/*
	respond @prive 404

	file_server
	handle_errors {
		@introuvable expression {err.status_code} == 404
		root * /srv/site
		rewrite @introuvable /404.html
		file_server
	}
}

# L'API : base de données, comptes, fichiers, fonctions serveur
api.{$DOMAINE} {
	# Taille maximale d'une requête : 25 Mo (pièces jointes de 5 Mo, envois groupés de bulletins)
	request_body {
		max_size 25MB
	}
	reverse_proxy api-gw:8000
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
		-X-Powered-By
	}
}

# Console technique (Supabase Studio) : mot de passe + liste d'adresses IP autorisées
studio.{$DOMAINE} {
	@refuse not remote_ip {$STUDIO_IP_AUTORISEES}
	route {
		abort @refuse
		basic_auth {
			import /config/dashboard-auth
		}
		reverse_proxy studio:3000
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
